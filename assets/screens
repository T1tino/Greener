    borderRadius: 6,
  },
  buttonCenterMode: {
    marginTop: 26,
    paddingHorizontal: width * 0.15,
    alignItems: 'center',
    justifyContent: 'center',
  },
  buttonLogin: {
    width: '100%',
    height: 48,
    borderRadius: 9,
  },
  loginButtonText: {
    color: colors.white,
